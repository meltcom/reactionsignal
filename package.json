{
  "name": "reaction-signal-pilot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "deploy": "npx wrangler@4 d1 migrations apply DB --remote && npx wrangler@4 deploy",
    "dev": "npm run build && npx wrangler@4 dev",
    "db:migrate": "npx wrangler@4 d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.44.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "esbuild": "^0.25.12",
    "read-excel-file": "9.3.10"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

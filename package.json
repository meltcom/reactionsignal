{
  "name": "reaction-signal-pilot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node --test tests/release-ui.test.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:staging": "node scripts/staging-load.mjs",
    "db:generate": "drizzle-kit generate",
    "deploy": "node scripts/deploy.mjs",
    "dev": "npm run build && npx wrangler@4 dev",
    "db:migrate": "npx wrangler@4 d1 migrations apply DB --remote",
    "deploy:preview": "npm run build && npx wrangler@4 preview",
    "deploy:check": "node scripts/check-build.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.44.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "esbuild": "^0.25.12",
    "read-excel-file": "9.3.10"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

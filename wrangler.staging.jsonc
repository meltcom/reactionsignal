{
  "name": "reactionsignal-staging",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reaction-signal-preview",
      "database_id": "ba7d7d84-6947-4bfc-9270-03d63ee699af",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "COMMUNITY_MODERATOR_EMAILS": "meltcom@gmail.com",
    "DISCOVERY_DAILY_SEARCH_LIMIT": "0",
    "MEMBER_EMAIL_ALLOWLIST": "meltcom@gmail.com",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_o6oNRLzJf_2d33qHjG9suQ_3GLk5g1Q",
    "SUPABASE_URL": "https://ovmvnfcbwirocsmtvaxd.supabase.co",
    "YOUTUBE_PUSH_CALLBACK_URL": "",
    "YOUTUBE_QUOTA_TRACKING": "0",
    "YOUTUBE_QUOTA_VERIFIED": "0",
    "YOUTUBE_GENERAL_DAILY_LIMIT": "0",
    "BACKFILL_DAILY_GENERAL_LIMIT": "300",
    "BACKFILL_GENERAL_RESERVE": "2000",
    "BACKFILL_ENABLED": "0"
  },
  "triggers": {
    "crons": []
  },
  "build": {
    "command": "node scripts/check-staging-config.mjs && node scripts/build.mjs && node --test tests/*.test.mjs && node scripts/check-build.mjs"
  }
}
